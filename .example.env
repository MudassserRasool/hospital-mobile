# ===========================================
# Mobile App Environment Variables
# ===========================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to `.env` in the same directory
# 2. Fill in your actual values (see instructions below)
# 3. NEVER commit `.env` to version control!
#
# ===========================================

# ---------------------------------------------
# Backend API Configuration
# ---------------------------------------------
# Your backend server URL
# Development: Use your local IP (find with `ipconfig` on Windows or `ifconfig` on Mac/Linux)
# Production: Use your production domain
# Example: http://192.168.1.100:3001 or https://api.yourdomain.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# ---------------------------------------------
# Google OAuth Configuration
# ---------------------------------------------
# For Expo Go (Development):
# - Use the SAME Web application Client ID for ALL four variables below
# - Get it from: https://console.cloud.google.com/apis/credentials
# - Must be "Web application" type (NOT iOS or Android)
# - Make sure redirect URI is: https://auth.expo.io/@yourname/medical-clinic
#
# For Production Builds:
# - Use platform-specific Client IDs (Android type for Android, iOS type for iOS)
# - See docs/GOOGLE_OAUTH_FIX.md for full instructions

# Main Client ID (Web application for Expo Go)
EXPO_PUBLIC_CLIENT_ID=

# Web Client ID (same as above for Expo Go, backend client ID for production)
EXPO_PUBLIC_WEB_CLIENT_ID=

# Android Client ID (same as above for Expo Go, Android type for production)
EXPO_PUBLIC_ANDROID_CLIENT_ID=

# iOS Client ID (same as above for Expo Go, iOS type for production)
EXPO_PUBLIC_IOS_CLIENT_ID=

# ---------------------------------------------
# Payment Configuration (Optional)
# ---------------------------------------------
# EasyPaisa merchant ID for payment processing
EXPO_PUBLIC_EASYPAISA_MERCHANT_ID=

# ---------------------------------------------
# Hospital Location Configuration (Optional)
# ---------------------------------------------
# For staff check-in verification
EXPO_PUBLIC_HOSPITAL_WIFI_SSID=HospitalWiFi
EXPO_PUBLIC_HOSPITAL_LATITUDE=31.4697
EXPO_PUBLIC_HOSPITAL_LONGITUDE=74.2728

# ===========================================
# EXAMPLE .env FILE (For Expo Go Development):
# ===========================================
# 
# EXPO_PUBLIC_API_BASE_URL=http://192.168.43.64:3001
# EXPO_PUBLIC_CLIENT_ID=123456789-abc123def456.apps.googleusercontent.com
# EXPO_PUBLIC_WEB_CLIENT_ID=123456789-abc123def456.apps.googleusercontent.com
# EXPO_PUBLIC_ANDROID_CLIENT_ID=123456789-abc123def456.apps.googleusercontent.com
# EXPO_PUBLIC_IOS_CLIENT_ID=123456789-abc123def456.apps.googleusercontent.com
# EXPO_PUBLIC_EASYPAISA_MERCHANT_ID=your-merchant-id
# EXPO_PUBLIC_HOSPITAL_WIFI_SSID=MyHospitalWiFi
# EXPO_PUBLIC_HOSPITAL_LATITUDE=31.5204
# EXPO_PUBLIC_HOSPITAL_LONGITUDE=74.3587
#
# ===========================================

# ---------------------------------------------
# TROUBLESHOOTING
# ---------------------------------------------
# 
# If you see "Error 400: invalid_request":
# 1. Make sure you're using a Web application Client ID (not iOS/Android)
# 2. Check redirect URI in Google Console is: https://auth.expo.io/@yourname/medical-clinic
# 3. Remove any redirect URIs that start with exp://
# 4. Add your Google account as a test user in OAuth consent screen
# 5. Wait 1-2 minutes after saving changes in Google Console
# 6. Restart Expo: npx expo start --clear
#
# For detailed help, see: docs/GOOGLE_OAUTH_FIX.md
# ---------------------------------------------

